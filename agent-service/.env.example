# ============================================
# Zhaozhou Bridge AI Tour Guide — Agent 服务环境变量
# ============================================

# 数据库配置
DATABASE_URL="postgresql://postgres:password@localhost:5433/zhaozhou_bridge?schema=public"

# JWT 配置（使用 RSA 私钥验证）
JWT_PRIVATE_KEY_PATH="/app/.keys/private.key"

# DeepSeek API 配置（用于 AI 对话，OpenAI 兼容接口）
DEEPSEEK_API_KEY="your-deepseek-api-key-here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

# OpenAI API 配置（用于 Embedding 向量化，text-embedding-3-small）
# 可直连 OpenAI 或通过代理访问
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_BASE_URL="https://api.openai.com"
EMBEDDING_MODEL="text-embedding-3-small"

# 服务器配置
PORT=3001
NODE_ENV="development"
