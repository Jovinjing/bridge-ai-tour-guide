generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// 用户表
model User {
  id        Int        @id @default(autoincrement())
  phone     String     @unique @db.VarChar(20)
  email     String?    @unique @db.VarChar(100)
  password  String?    @db.VarChar(255)
  nickname  String     @db.VarChar(50)
  avatarUrl String?    @map("avatar_url") @db.VarChar(500)
  createdAt DateTime?  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime?  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  favorites Favorite[]
  orders    Order[]
  cartItems CartItem[]
  addresses Address[]

  @@index([phone], map: "idx_users_phone")
  @@map("users")
}

/// 验证码表
model VerificationCode {
  id        Int       @id @default(autoincrement())
  phone     String    @db.VarChar(20)
  code      String    @db.VarChar(6)
  type      String    @db.VarChar(50)
  expiresAt DateTime  @map("expires_at") @db.Timestamp(6)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  @@index([phone], map: "idx_verification_codes_phone")
  @@map("verification_codes")
}

/// 文创商品表
model Good {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  description String?
  price       Decimal   @db.Decimal(10, 2)
  stock       Int?      @default(0)
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  orders      Order[]
  cartItems   CartItem[]

  @@index([stock], map: "idx_goods_stock")
  @@map("goods")
}

/// 门票表（含热力图）
model Ticket {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  description String?
  price       Decimal   @db.Decimal(10, 2)
  stock       Int?      @default(0)
  hotspots    Json?
  imageUrls   Json?     @map("image_urls")
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  orders      Order[]

  @@index([stock], map: "idx_tickets_stock")
  @@map("tickets")
}

/// 订单表
model Order {
  id          Int       @id @default(autoincrement())
  userId      Int       @map("user_id")
  goodId      Int?      @map("good_id")
  ticketId    Int?      @map("ticket_id")
  quantity    Int?      @default(1)
  totalAmount Decimal   @map("total_amount") @db.Decimal(10, 2)
  status      String?   @default("pending") @db.VarChar(50)
  paymentTime DateTime? @map("payment_time") @db.Timestamp(6)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  good        Good?     @relation(fields: [goodId], references: [id], onUpdate: NoAction)
  ticket      Ticket?   @relation(fields: [ticketId], references: [id], onUpdate: NoAction)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_orders_status")
  @@index([userId], map: "idx_orders_user_id")
  @@map("orders")
}

/// 文化内容表（10篇赵州桥知识文档）
model Cultural {
  id        Int       @id @default(autoincrement())
  title     String    @db.VarChar(200)
  content   String
  category  String?   @db.VarChar(100)
  imageUrl  String?   @map("image_url") @db.VarChar(500)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([category], map: "idx_cultural_category")
  @@map("cultural")
}

/// 收藏表
model Favorite {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  targetType String    @map("target_type") @db.VarChar(50)
  targetId   Int       @map("target_id")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, targetType, targetId], map: "idx_favorites_target")
  @@index([userId], map: "idx_favorites_user_id")
  @@map("favorites")
}

/// 购物车项表
model CartItem {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  goodId    Int?      @map("good_id")
  quantity  Int       @default(1)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  good      Good?     @relation(fields: [goodId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, goodId], map: "uk_cart_user_good")
  @@index([userId], map: "idx_cart_user_id")
  @@map("cart_items")
}

/// 收货地址表
model Address {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  name      String    @db.VarChar(50)
  phone     String    @db.VarChar(20)
  province  String    @db.VarChar(50)
  city      String    @db.VarChar(50)
  district  String    @db.VarChar(50)
  detail    String    @db.VarChar(255)
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_addresses_user_id")
  @@map("addresses")
}

model agent_messages {
  id         String    @id @db.VarChar(50)
  session_id String    @db.VarChar(50)
  role       String    @db.VarChar(50)
  content    String?
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([session_id], map: "idx_agent_messages_session_id")
}

model agent_sessions {
  id         String    @id @db.VarChar(50)
  user_id    String?   @db.VarChar(100)
  session_id String    @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([session_id], map: "idx_agent_sessions_session_id")
}

model agent_tool_calls {
  id         String    @id @db.VarChar(50)
  message_id String    @db.VarChar(50)
  tool_name  String    @db.VarChar(100)
  arguments  String?
  result     String?
  created_at DateTime? @default(now()) @db.Timestamp(6)

  @@index([message_id], map: "idx_agent_tool_calls_message_id")
}
