# ============================================
# Zhaozhou Bridge AI Tour Guide — NestJS 后端环境变量
# ============================================

# 数据库配置
DATABASE_URL="postgresql://postgres:password@localhost:5433/zhaozhou_bridge?schema=public"

# JWT 配置（使用 RSA 非对称加密）
# JWT 公钥文件路径（用于签名）
JWT_PUBLIC_KEY_PATH="/app/.keys/public.key"
# JWT 私钥文件路径（用于验证，仅在需要签发 token 时使用）
JWT_PRIVATE_KEY_PATH="/app/.keys/private.key"

# DeepSeek API 配置（用于 Agent 服务）
DEEPSEEK_API_KEY="your-deepseek-api-key-here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# 服务器配置
PORT=3000
NODE_ENV="development"
