# ============================================
# 赵州桥AI科普导游系统 — 生产环境变量模板
# ============================================
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env
# ============================================

# --- 数据库 ---
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=zhaozhou_bridge

# --- JWT ---
JWT_SECRET=change-me-jwt-secret
JWT_PRIVATE_KEY_PATH=/app/.keys/private.key

# --- LLM API（AI 对话，主模型：智谱 GLM OpenAI 兼容接口） ---
DEEPSEEK_API_KEY=your-zhipu-api-key
DEEPSEEK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DEEPSEEK_MODEL=glm-4-flash

# --- LLM 备用模型（主模型不稳定时自动切换：DeepSeek 官方 API） ---
# 获取 key: https://platform.deepseek.com/ → API Keys
DEEPSEEK_FALLBACK_API_KEY=your-deepseek-api-key
DEEPSEEK_FALLBACK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FALLBACK_MODEL=deepseek-chat

# --- Embedding API（向量化，硅基流动免费模型 bge-m3，1024 维） ---
# 获取 key: https://cloud.siliconflow.cn/ → API 密钥
OPENAI_API_KEY=your-siliconflow-api-key
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
